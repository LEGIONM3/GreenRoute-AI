# ==========================================
# SMART WASTE MANAGEMENT PLATFORM - ENV FILE
# ==========================================

# Core Application Settings
PROJECT_NAME="Smart Waste Management & Disposal Guidance Platform"
API_V1_STR=/api/v1
SECRET_KEY=replace_this_with_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (SQLite in local dev, PostgreSQL in Docker/Prod)
# For SQLite: sqlite:///./waste_management.db
# For PostgreSQL: postgresql://wasteuser:wastepass123@localhost:5432/wastedb
DATABASE_URL=sqlite:///./waste_management.db

# Storage
MAX_UPLOAD_SIZE_MB=10

# AI & RAG Configuration
# Options: "hybrid", "gemini", "openai", "mock"
LLM_PROVIDER=hybrid
OPENAI_API_KEY=
GEMINI_API_KEY=
RAG_SIMILARITY_THRESHOLD=0.35
RAG_TOP_K=4

# Default Seed Credentials
ADMIN_EMAIL=admin@wastecare.gov
ADMIN_PASSWORD=Admin@123456
CITIZEN_EMAIL=citizen@wastecare.gov
CITIZEN_PASSWORD=Citizen@123456

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
